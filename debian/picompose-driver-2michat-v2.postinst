#!/bin/sh
set -e

# Overlay directory of the Raspberry Pi firmware. It is on a FAT partition, which has no hard links,
# so dpkg cannot replace files there during an upgrade. The package copies the overlay instead.
OVERLAY=/usr/lib/picompose-driver-2michat-v2/respeaker-2mic-v2_0.dtbo

overlays_dir() {
    for dir in /boot/firmware/overlays /boot/overlays; do
        [ -d "$dir" ] && { echo "$dir"; return 0; }
    done
    return 0
}

# Boot configuration file of the Raspberry Pi
boot_config() {
    config=/boot/config.txt
    [ -f /boot/firmware/config.txt ] && config=/boot/firmware/config.txt
    [ -f /boot/firmware/usercfg.txt ] && config=/boot/firmware/usercfg.txt
    echo "$config"
}

# Make sure a line is in the boot configuration exactly once
add_boot_line() {
    config="$(boot_config)"
    [ -f "$config" ] || return 0
    grep -qx "$1" "$config" || echo "$1" >> "$config"
}

# Switch a commented parameter on
enable_boot_param() {
    config="$(boot_config)"
    [ -f "$config" ] || return 0
    sed -i -e "s:^#$1=on:$1=on:" "$config"
    grep -qx "$1=on" "$config" || echo "$1=on" >> "$config"
}

remove_boot_line() {
    config="$(boot_config)"
    [ -f "$config" ] || return 0
    sed -i "\\#^$1\$#d" "$config"
}

case "$1" in
    configure)
        # Copy the overlay to the firmware partition
        dir="$(overlays_dir)"
        [ -z "$dir" ] || install -m 644 "$OVERLAY" "$dir/respeaker-2mic-v2_0.dtbo"

        # Enable I2C and load the overlay of the ReSpeaker 2-Mics Pi HAT V2.0
        enable_boot_param dtparam=i2c_arm
        add_boot_line dtoverlay=respeaker-2mic-v2_0
        ;;
esac

#DEBHELPER#

exit 0
