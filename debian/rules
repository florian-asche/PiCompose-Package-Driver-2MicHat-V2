#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	dtc -@ -Wno-unit_address_vs_reg -I dts -O dtb -o respeaker-2mic-v2_0.dtbo src/respeaker-2mic-v2_0-overlay.dts

override_dh_auto_clean:
	rm -f respeaker-2mic-v2_0.dtbo

override_dh_installsystemd:
	dh_installsystemd --no-start --no-restart-after-upgrade configure_audio.service
